NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Sign in, copy the account identifier displayed by the app, then set it here.
# No account can claim the owner role until this is explicitly configured.
OWNER_SPOTIFY_ID=

# Turso database credentials (https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=

# Vercel Blob storage token (auto-injected by Vercel; set manually for local dev)
BLOB_READ_WRITE_TOKEN=

# Set to 1 locally to preview the partner UI while signed in as your own account.
# Never set this in production.
# TEST_AS_PARTNER=1
