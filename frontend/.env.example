NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Sign in, copy the account identifier displayed by the app, then set it here.
# No account can claim the owner role until this is explicitly configured.
OWNER_SPOTIFY_ID=
# Optional absolute path on a persistent disk (default: frontend/.data/archive.sqlite)
ARCHIVE_DB_PATH=

# Set to 1 locally to preview the partner UI while signed in as your own account.
# Never set this in production.
# TEST_AS_PARTNER=1
